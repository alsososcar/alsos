{
  "name": "@alsos/utils",
  "version": "0.0.0",
  "scripts": {
    "check-types": "tsc --noemit",
    "lint": "pnpm run check-types && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "imports": {
    "#env": "./env/index.ts",
    "#env/*": "./env/*.ts",
    "#*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "exports": {
    "./*": [
      "./src/*.ts"
    ]
  },
  "devDependencies": {
    "@alsos/eslint-config": "workspace:*",
    "@alsos/typescript-config": "workspace:*",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "eslint": "10.4.1",
    "typescript": "7.0.2"
  }
}
