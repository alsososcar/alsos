{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alsos-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-19",
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "placement": {
    "region": "aws:eu-central-1",
  },
  "r2_buckets": [
    {
      "binding": "ALSOS_ASSETS",
      "bucket_name": "alsos-assets",
      "jurisdiction": "eu",
      "remote": true,
    },
  ],
  "env": {
    "development": {
      "name": "alsos-media-development",
      "r2_buckets": [
        {
          "binding": "ALSOS_ASSETS",
          "bucket_name": "alsos-assets-dev",
          "jurisdiction": "eu",
          "remote": true,
        },
      ],
    },
    "local_development": {
      "name": "alsos-media-local_development",
      "r2_buckets": [
        {
          "binding": "ALSOS_ASSETS",
          "bucket_name": "alsos-assets-dev",
          "jurisdiction": "eu",
          "remote": false,
        },
      ],
    },
  },
}
