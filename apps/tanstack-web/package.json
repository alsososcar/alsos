{
  "name": "@alsos/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite dev --port 45100",
    "generate-routes": "tsr generate",
    "auth:schema": "bunx auth@latest generate --adapter drizzle --dialect postgresql --config ./src/lib/auth.ts --output ../../packages/database/src/schema/auth-schema.ts --yes",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:auth": "./scripts/test-auth.sh unit",
    "test:auth:integration": "./scripts/test-auth.sh integration",
    "test:auth:e2e": "playwright test --config=playwright.config.ts",
    "test:auth:ci": "./scripts/test-auth.sh all",
    "test:auth:neon": "./scripts/neon-auth-tests.sh",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@alsos/database": "workspace:*",
    "@alsos/env": "workspace:*",
    "@alsos/ui": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "1.7.2",
    "lucide-react": "1.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@alsos/eslint-config": "workspace:*",
    "@cloudflare/vite-plugin": "1.26.0",
    "@content-collections/core": "0.13.1",
    "@content-collections/vite": "0.3.0",
    "@eslint/js": "9.39.5",
    "@tailwindcss/typography": "0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "1.132.0",
    "@playwright/test": "latest",
    "drizzle-orm": "rc",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "portless": "0.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.0",
    "vitest": "4.1.9",
    "wrangler": "4.102.0"
  },
  "portless": {
    "name": "www.alsos",
    "script": "dev:app",
    "proxy": true,
    "appPort": 45100
  }
}
