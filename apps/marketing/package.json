    "@vercel/functions": "3.7.1",
    "babel-plugin-react-compiler": "1.0.0",
    "lucide-react": "1.20.0",
    "next": "16.2.9",
    "next-intl": "4.13.0",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@alsos/eslint-config": "workspace:*",
    "@alsos/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.1",
