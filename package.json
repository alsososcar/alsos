{
  "name": "alsos",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "monorepo:lint": "pnpx sherif@latest",
    "monorepo:fix": "pnpx sherif@latest --fix",
    "format": "oxfmt apps/tanstack-web",
    "format-check": "oxfmt --check apps/tanstack-web"
  },
  "devDependencies": {
    "@alsos/eslint-config": "workspace:*",
    "@alsos/typescript-config": "workspace:*",
    "oxfmt": "0.16.0",
    "shadcn": "4.11.0",
    "turbo": "2.9.18",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
